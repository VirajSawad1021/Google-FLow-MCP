{
  "name": "google-flow-mcp",
  "version": "1.0.0",
  "description": "Custom Model Context Protocol (MCP) server for Google Flow Web UI using persistent browser automation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "login": "node ./scripts/login.js",
    "launch": "node ./scripts/login.js",
    "warm": "node ./scripts/warm-browser.js",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "google-flow",
    "veo",
    "imagen",
    "ai-generation",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
